CONFIG_BASE_PATH=/srv/containers_data/keycloak-test/config-files
DATA_BASE_PATH=/srv/containers_data/keycloak-test/data
CERTIFICATES_PATH=/srv/containers_data/keycloak-test/certificates
LOGS_PATH=/srv/containers_data/keycloak-test/logs

DOCKER_USER=1002
DOCKER_GROUP=1001

# Ports
KEYCLOAK_PORT=8443

POSTGRESQL_DB_KEYCLOAK_PORT=5532
DB_KEYCLOAK_NAME={{DB_KEYCLOAK_NAME}}
DB_KEYCLOAK_USERNAME={{DB_KEYCLOAK_USERNAME}}
DB_KEYCLOAK_PASSWORD={{DB_KEYCLOAK_PASSWORD}}

# Keycloak
KEYCLOAK_USERNAME={{KEYCLOAK_USERNAME}}
KEYCLOAK_PASSWORD={{KEYCLOAK_PASSWORD}}

KEYCLOAK_VERSION_TAG=26.1.3
POSTGRES_VERSION_TAG=1.8
NGINX_VERSION_TAG=mainline-alpine